# Optional: auto-register a default embedding model on startup.
# Prefer configuring Embedding models in the web UI (Model Settings → Embedding Models).
# Set these in your shell or process manager — never commit real keys.
LNE_EMBEDDING_API_KEY=your-api-key-here
LNE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LNE_EMBEDDING_MODEL=text-embedding-v3
LNE_BAIDU_EMBEDDING_API_KEY=your-aistudio-access-token-here
LNE_BAIDU_EMBEDDING_BASE_URL=https://aistudio.baidu.com/llm/lmapi/v3
LNE_BAIDU_EMBEDDING_MODEL=bge-large-zh
# Optional: PaddleOCR-VL for scanned PDF/PPT when native text extraction is empty.
# Falls back to LNE_BAIDU_EMBEDDING_API_KEY when unset.
LNE_BAIDU_PADDLEOCR_TOKEN=your-aistudio-access-token-here
LNE_BAIDU_PADDLEOCR_MODEL=PaddleOCR-VL-1.6
