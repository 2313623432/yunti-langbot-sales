{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "public",
  "installCommand": "pnpm install",
  "rewrites": [
    {
      "source": "/",
      "destination": "https://registered-probe-nutrition-thesis.trycloudflare.com/"
    },
    {
      "source": "/:match*",
      "destination": "https://registered-probe-nutrition-thesis.trycloudflare.com/:match*"
    }
  ]
}
